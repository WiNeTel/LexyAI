# Lexy WhatsApp Bridge — Environment Variables
# Copy this to .env and adjust as needed.

# Port the REST server listens on (Lexy polls http://127.0.0.1:PORT)
BRIDGE_PORT=3000

# Shared secret between bridge and Lexy's channel_whatsapp plugin.
# Must match the api_key in config/plugins.yaml → channel_whatsapp.
BRIDGE_API_KEY=lexy-secret

# Directory where Baileys stores the WhatsApp session credentials.
# Delete this folder to force a fresh QR code scan.
# BRIDGE_AUTH_DIR=./auth_state
